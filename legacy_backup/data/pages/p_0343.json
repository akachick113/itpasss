    {
      "type": "formula",
      "title": {
        "ja": "組み合わせの公式",
        "vi": "Công thức tổ hợp",
        "en": "Combination Formula"
      },
      "content": "ₙCᵣ = n! / r!(n-r)!",
      "example": {
        "ja": "₅C₂ = 5! / 2!(5-2)! = (5×4×3×2×1) / (2×1)(3×2×1) = (5×4) / (2×1) = 20/2 = 10（通り）",
        "vi": "₅C₂ = 5! / 2!(5-2)! = (5×4×3×2×1) / (2×1)(3×2×1) = (5×4) / (2×1) = 20/2 = 10 (cách)",
        "en": "₅C₂ = 5! / 2!(5-2)! = (5×4×3×2×1) / (2×1)(3×2×1) = (5×4) / (2×1) = 20/2 = 10 (ways)"
      }
    },
    {
      "type": "paragraph",
      "ja": "同様に、7人の中から3人を選び出す場合の組み合わせの数は以下になります。",
