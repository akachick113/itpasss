      "rows": [
        {
          "operator": "AND",
          "description": {
            "ja": "AとBの両方が「1」の場合に、答えが「1」になる論理演算。「論理積」とも呼ばれる",
            "vi": "Phép toán logic cho kết quả \"1\" khi cả A và B đều là \"1\". Còn gọi là \"tích logic\"",
            "en": "Logical operation where result is '1' when both A and B are '1.' Also called 'logical product'"
          }
        },
        {
          "operator": "OR",
          "description": {
            "ja": "AとBの少なくとも一方が「1」の場合に、答えが「1」になる論理演算。「論理和」とも呼ばれる",
            "vi": "Phép toán logic cho kết quả \"1\" khi ít nhất một trong A hoặc B là \"1\". Còn gọi là \"tổng logic\"",
            "en": "Logical operation where result is '1' when at least one of A or B is '1.' Also called 'logical sum'"
          }
        },
        {
          "operator": "XOR",
          "description": {
            "ja": "AとBが異なる場合に「1」、AとBが同じ場合は「0」になる論理演算。「排他的論理和」とも呼ばれる",
            "vi": "Phép toán logic cho kết quả \"1\" khi A và B khác nhau, \"0\" khi giống nhau. Còn gọi là \"XOR - hoặc loại trừ\"",
            "en": "Logical operation where result is '1' when A and B differ, '0' when same. Also called 'exclusive OR'"
          }
        },
        {
          "operator": "NOT",
          "description": {
            "ja": "入力の反対が答えになる論理演算。「否定」とも呼ばれる",
            "vi": "Phép toán logic mà đáp án là ngược lại đầu vào. Còn gọi là \"phủ định\"",
            "en": "Logical operation where answer is opposite of input. Also called 'negation'"
          }
        }
      ]
    },
